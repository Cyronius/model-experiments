4, 4)\n\nFourth iteration: (-4-4, 4-(-4), -4-4, 4-(-4)) = (-8, 8, -8, 8)\n\nSo here, the numbers are doubling in absolute value each time. So they grow exponentially. Thus, in this case, the maximum absolute value is increasing by a factor of 2 each iteration. \n\nWait, so this is interesting. In this case, the vector is alternating between two values, and each iteration flips the sign and doubles the magnitude. So, starting with (1, 2, 1, 2), it becomes (-1, 1, -1, 1), then (-2, 2, -2, 2), etc. So, each step alternates signs and doubles the differences. So, in this case, the growth is clear. \n\nAnother example: start with (0, 1, 0, 0). Let's see:\n\nFirst iteration: (0-1, 1-0, 0-0, 0-0) = (-1, 1, 0, 0)\n\nSecond iteration: (-1-1, 1-0, 0-0, 0 - (-1)) = (-2, 1, 0, 1)\n\nThird iteration: (-2 -1, 1 -0, 0 -1, 1 - (-2)) = (-3, 1, -1, 3)\n\nFourth iteration: (-3 -1, 1 - (-1), -1 -3, 3 - (-3)) = (-4, 2, -4, 6)\n\nFifth iteration: (-4 -2, 2 - (-4), -4 -6, 6 - (-4)) = (-6, 6, -10, 10)\n\nSixth iteration: (-6 -6, 6 - (-10), -10 -10, 10 - (-6)) = (-12, 16, -20, 16)\n\nSeventh iteration: (-12 -16, 16 - (-20), -20 -16, 16 - (-12)) = (-28, 36, -36, 28)\n\nEighth iteration: (-28 -36, 36 - (-36), -36 -28, 28 - (-28)) = (-64, 72, -64, 56)\n\nNinth iteration: (-64 -72, 72 - (-64), -64 -56, 56 - (-64)) = (-136, 136, -120, 120)\n\nTenth iteration: (-136 -136, 136 - (-120), -120 -120, 120 - (-136)) = (-272, 256, -240, 256)\n\nEleventh iteration: (-272 -256, 256 - (-240), -240 -256, 256 - (-272)) = (-528, 496, -496, 528)\n\nSo, again, the numbers continue to grow. Even though sometimes individual components might decrease, the overall trend is that the maximum absolute value is increasing. \n\nThis seems to support the idea that unless all numbers start equal, the differences will propagate and amplify, leading to unbounded growth. But how can we formalize this?\n\nPerhaps we can look for an invariant or a quantity that grows with each iteration. For example, maybe the sum of the absolu
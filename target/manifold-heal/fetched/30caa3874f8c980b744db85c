 \\alpha)} \\right)^2 + \\left( \\frac{c (\\cos \\beta - \\cos \\alpha)}{\\sin (\\beta - \\alpha)} \\right)^2.\n   \\]\n\n9. Factoring out \\( \\frac{c^2}{\\sin^2 (\\beta - \\alpha)} \\), we have:\n   \\[\n   a^2 + b^2 = \\frac{c^2}{\\sin^2 (\\beta - \\alpha)} \\left( (\\sin \\beta - \\sin \\alpha)^2 + (\\cos \\beta - \\cos \\alpha)^2 \\right).\n   \\]\n\n10. Using the trigonometric identity:\n    \\[\n    (\\sin \\beta - \\sin \\alpha)^2 + (\\cos \\beta - \\cos \\alpha)^2 = 4 \\sin^2 \\left( \\frac{\\beta - \\alpha}{2} \\right),\n    \\]\n    it follows that:\n    \\[\n    a^2 + b^2 = \\frac{c^2}{\\sin^2 (\\beta - \\alpha)} \\cdot 4 \\sin^2 \\left( \\frac{\\beta - \\alpha}{2} \\right).\n    \\]\n\n11. Simplify the equation using \\(\\sin (\\beta - \\alpha) = 2 \\sin \\left( \\frac{\\beta - \\alpha}{2} \\right) \\cos \\left( \\frac{\\beta - \\alpha}{2} \\right)\\), we then have:\n    \\[\n    a^2 + b^2 = \\frac{c^2 \\cdot 4 \\sin^2 \\left( \\frac{\\beta - \\alpha}{2} \\right)}{4 \\sin^2 \\left( \\frac{\\beta - \\alpha}{2} \\right) \\cos^2 \\left( \\frac{\\beta - \\alpha}{2} \\right)} = \\frac{c^2}{\\cos^2 \\left( \\frac{\\alpha - \\beta}{2} \\right)}.\n    \\]\n\n12. Finally, solving for \\( \\cos^2 \\left( \\frac{\\alpha - \\beta}{2} \\right) \\), we get:\n   \\[\n   \\cos^2 \\left( \\frac{\\alpha - \\beta}{2} \\right) = \\frac{c^2}{a^2 + b^2}.\n   \\]\n\n### Conclusion:\n\\[\n\\boxed{\\cos^2 \\left( \\frac{\\alpha - \\beta}{2} \\right) = \\frac{c^2}{a^2 + b^2}}\n\\]", "domain": "math", "source": "numina_math", "test_cases": null, "starter_code": null}, {"problem": "Given five points inside an equilateral triangle of side length 2, show that there are two points whose distance from each other is at most 1.", "deepseek_reasoning": "Okay, so I have this problem: Given five points inside an equilateral triangle of side length 2, show that there are two points whose distance from each other is at most 1. Hmm, let me think. I remember something about the pigeonhole prin
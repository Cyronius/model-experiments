0b2)/4 - c\u00b2 t + c\u00b2 )\n\nTherefore, cos(angle BCM) = [ c(1 - t/2 ) ] / sqrt( t\u00b2(c\u00b2 + b\u00b2)/4 - c\u00b2 t + c\u00b2 )\n\n= [ c(2 - t)/2 ] / sqrt( [ t\u00b2(c\u00b2 + b\u00b2) -4c\u00b2 t +4c\u00b2 ] /4 )\n\n= [ c(2 - t)/2 ] / [ sqrt( t\u00b2(c\u00b2 + b\u00b2) -4c\u00b2 t +4c\u00b2 ) /2 ]\n\n= [ c(2 - t) ] / sqrt( t\u00b2(c\u00b2 + b\u00b2) -4c\u00b2 t +4c\u00b2 )\n\nNow, compare cos(angle BAM) and cos(angle BCM):\n\ncos(angle BAM) = [ b(2 - t) ] / sqrt( t\u00b2c\u00b2 + b\u00b2(t - 2)^2 )\n\ncos(angle BCM) = [ c(2 - t) ] / sqrt( t\u00b2(c\u00b2 + b\u00b2) -4c\u00b2 t +4c\u00b2 )\n\nTo show that cos(angle BAM) < cos(angle BCM), which would imply angle BAM > angle BCM.\n\nSo, we need to show:\n\n[ b(2 - t) ] / sqrt( t\u00b2c\u00b2 + b\u00b2(t - 2)^2 ) < [ c(2 - t) ] / sqrt( t\u00b2(c\u00b2 + b\u00b2) -4c\u00b2 t +4c\u00b2 )\n\nSince 2 - t is positive (as t \u2208 [0,1]), we can divide both sides by (2 - t):\n\nb / sqrt( t\u00b2c\u00b2 + b\u00b2(t - 2)^2 ) < c / sqrt( t\u00b2(c\u00b2 + b\u00b2) -4c\u00b2 t +4c\u00b2 )\n\nSquare both sides (since denominators are positive):\n\nb\u00b2 / [ t\u00b2c\u00b2 + b\u00b2(t - 2)^2 ] < c\u00b2 / [ t\u00b2(c\u00b2 + b\u00b2) -4c\u00b2 t +4c\u00b2 ]\n\nCross-multiply:\n\nb\u00b2 [ t\u00b2(c\u00b2 + b\u00b2) -4c\u00b2 t +4c\u00b2 ] < c\u00b2 [ t\u00b2c\u00b2 + b\u00b2(t - 2)^2 ]\n\nExpand both sides:\n\nLeft side: b\u00b2 t\u00b2(c\u00b2 + b\u00b2) -4b\u00b2c\u00b2 t +4b\u00b2c\u00b2\n\nRight side: c\u00b2 t\u00b2c\u00b2 + c\u00b2 b\u00b2(t\u00b2 -4t +4 )\n\n= c\u2074 t\u00b2 + c\u00b2 b\u00b2 t\u00b2 -4c\u00b2 b\u00b2 t +4c\u00b2 b\u00b2\n\nSo the inequality is:\n\nb\u00b2 t\u00b2(c\u00b2 + b\u00b2) -4b\u00b2c\u00b2 t +4b\u00b2c\u00b2 < c\u2074 t\u00b2 + c\u00b2 b\u00b2 t\u00b2 -4c\u00b2 b\u00b2 t +4c\u00b2 b\u00b2\n\nSimplify both sides:\n\nLeft side:\n\n= b\u00b2c\u00b2 t\u00b2 + b\u2074 t\u00b2 -4b\u00b2c\u00b2 t +4b\u00b2c\u00b2\n\nRight side:\n\n= c\u2074 t\u00b2 + c\u00b2b\u00b2 t\u00b2 -4c\u00b2b\u00b2 
n49^4=49\u00b2=2,401; 2,401\u00b2=5,764,801  \n50^4=50\u00b2=2,500; 2,500\u00b2=6,250,000\n\nSumming:\n\n16 +81=97  \n97 +20,736=20,833  \n20,833 +194,481=215,314  \n215,314 +923,521=1,138,835  \n1,138,835 +2,560,000=3,698,835  \n3,698,835 +5,764,801=9,463,636  \n9,463,636 +6,250,000=15,713,636\n\nSame result, 15,713,636. So k=4 is good.\n\nk=5: Fifth powers. Oh boy, this is going to be time-consuming. Let's start with the first set.\n\nFirst set:\n\n1^5=1  \n5^5=3,125  \n10^5=100,000  \n24^5=24^4 *24 =331,776 *24. Let's compute 331,776 *20=6,635,520 and 331,776 *4=1,327,104. Total=6,635,520 +1,327,104=7,962,624  \n28^5=28^4 *28=614,656 *28. Let's do 614,656 *20=12,293,120 and 614,656 *8=4,917,248. Total=12,293,120 +4,917,248=17,210,368  \n42^5=42^4 *42=3,111,696 *42. 3,111,696 *40=124,467,840 and 3,111,696 *2=6,223,392. Total=124,467,840 +6,223,392=130,691,232  \n47^5=47^4 *47=4,879,681 *47. Let's compute 4,879,681 *40=195,187,240 and 4,879,681 *7=34,157,767. Total=195,187,240 +34,157,767=229,345,007  \n51^5=51^4 *51=6,765,201 *51. 6,765,201 *50=338,260,050 and 6,765,201 *1=6,765,201. Total=338,260,050 +6,765,201=345,025,251\n\nNow sum these:\n\n1 +3,125=3,126  \n3,126 +100,000=103,126  \n103,126 +7,962,624=8,065,750  \n8,065,750 +17,210,368=25,276,118  \n25,276,118 +130,691,232=155,967,350  \n155,967,350 +229,345,007=385,312,357  \n385,312,357 +345,025,251=730,337,608\n\nSecond set:\n\n2^5=32  \n3^5=243  \n12^5=12^4 *12=20,736 *12=248,832  \n21^5=21^4 *21=194,481 *21. 194,481 *20=3,889,620 and 194,481 *1=194,481. Total=3,889,620 +194,481=4,084,101  \n31^5=31^4 *31=923,521 *31. Let's do 923,521 *30=27,705,630 and 923,521 *1=923,521. Total=27,705,630 +923,521=28,629,151  \n40^5=40^4 *40=2,560,000 *40=102,400,000  \n49^5=49^4 *49=5,764,801 *49. Compute 5,764,801 *40=230,592,040 and 5,764,801 *9=51,883,209. Total=230,592,040 +51,883,209=282,475,249  \n50^5=50^4 *50=6,250,000 *50=312,500,000\n\nSumming up:\n\n32 +243=275  \n275 +248,832=249,107  \n249,107 +4,084,101=4,333,208  \n4,333,208 +28,629,151=32,962,359  \n32,962,359 +102,400,000=135,362,359  \n135,362,359 +282,475,249=417,837,608  \n417,837,608 +312,500,000=730,337,608\n\nSame result! 730,337,608. So k=5 matches.\n\nk=6: Sixth powers. This is getting really big. Let me try to compute these step by step.\n\nFirst set:\n\n1^6=1  \n5^6=15,625  \n10^6=1,000,000  \n24^6=24^5 *24=7,962,624 *24. Let's compute 7,962,624 *20=159,252,480 and 7,962,624 *4=31,850,496. Total=159,252,480 +31,850,496=191,102,976  \n28^6=28^5 *28=17,210,368 *28. 17,210,368 *20=344,207,360 and 17,210,368 *8=137,682,944. Total=344,207,360 +137,682,944=481,890,304  \n42^6=42^5 *42=130,691,232 *42. 130,691,232 *40=5,227,649,280 and 130,691,232 *2=261,382,464. Total=5,227,649,280 +261,382,464=5,489,031,744  \n47^6=47^5 *47=229,345,007 *47. Let's break it down: 229,345,007 *40=9,173,800,280 and 229,345,007 *7=1,605,415,049. Total=9,173,800,280 +1,605,415,049=10,779,215,329  \n51^6=51^5 *51=345,025,251 *51. Compute 345,025,251 *50=17,251,262,550 and 345,025,251 *1=345,025,251. Total=17,251,262,550 +345,025,251=17,596,287,801\n\nNow sum them:\n\n1 +15,625=15,626  \n15,626 +1,000,000=1,015,626  \n1,015,626 +191,102,976=192,118,602  \n192,118,602 +481,890,304=674,008,906  \n674,008,906 +5,489,031,744=6,163,040,650  \n6,163,040,650 +10,779,215,329=16,942,255,979  \n16,942,255,979 +17,596,287,801=34,538,543,780\n\nSecond set:\n\n2^6=64  \n3^6=729  \n12^6=12^5 *12=248,832 *12=2,985,984  \n21^6=21^5 *21=4,084,101 *21. 4,084,101 *20=81,682,020 and 4,084,101 *1=4,084,101. Total=81,682,020 +4,084,101=85,766,121  \n31^6=31^5 *31=28,629,151 *31. 28,629,151 *30=858,874,530 and 28,629,151 *1=28,629,151. Total=858,874,530 +28,629,151=887,503,681  \n40^6=40^5 *40=102,400,000 *40=4,096,000,000  \n49^6=49^5 *49=282,475,249 *49. 282,475,249 *40=11,299,009,960 and 282,475,249 *9=2,542,277,241. Total=11,299,009,960 +2,542,277,241=13,841,287,201  \n50^6=50^5 *50=312,500,000 *50=15,625,000,000\n\nSumming:\n\n64 +729=793  \n793 +2,98
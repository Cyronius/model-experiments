]\n\n= - sin \u03b8 [ 1/(9 -4\u221a5 cos \u03b8 ) -1/(9 +4\u221a5 cos \u03b8 ) ]\n\n= - sin \u03b8 [ (9 +4\u221a5 cos \u03b8 -9 +4\u221a5 cos \u03b8 ) / ( (9 -4\u221a5 cos \u03b8 )(9 +4\u221a5 cos \u03b8 ) ) ]\n\n= - sin \u03b8 [ (8\u221a5 cos \u03b8 ) / (81 - (4\u221a5 cos \u03b8 )\u00b2 ) ]\n\nSimplify denominator:\n\n(4\u221a5 cos \u03b8 )\u00b2 =16*5 cos\u00b2 \u03b8=80 cos\u00b2 \u03b8\n\nThus, denominator=81 -80 cos\u00b2 \u03b8\n\nTherefore, N_y - M_y = - sin \u03b8 * (8\u221a5 cos \u03b8 ) / (81 -80 cos\u00b2 \u03b8 )\n\nSimilarly, compute N_x - M_x:\n\n[ (20 -9\u221a5 cos \u03b8 )/(9 -4\u221a5 cos \u03b8 ) ] - [ (-20 -9\u221a5 cos \u03b8 )/(9 +4\u221a5 cos \u03b8 ) ]\n\n= [ (20 -9\u221a5 cos \u03b8 )(9 +4\u221a5 cos \u03b8 ) + (20 +9\u221a5 cos \u03b8 )(9 -4\u221a5 cos \u03b8 ) ] / [ (9 -4\u221a5 cos \u03b8 )(9 +4\u221a5 cos \u03b8 ) ]\n\nCompute numerator:\n\nFirst term: (20)(9) +20*4\u221a5 cos \u03b8 -9\u221a5 cos \u03b8 *9 -9\u221a5 cos \u03b8 *4\u221a5 cos \u03b8\n\n=180 +80\u221a5 cos \u03b8 -81\u221a5 cos \u03b8 -36*5 cos\u00b2 \u03b8\n\n=180 -\u221a5 cos \u03b8 -180 cos\u00b2 \u03b8\n\nSecond term: (20)(9) -20*4\u221a5 cos \u03b8 +9\u221a5 cos \u03b8*9 -9\u221a5 cos \u03b8*4\u221a5 cos \u03b8\n\n=180 -80\u221a5 cos \u03b8 +81\u221a5 cos \u03b8 -180 cos\u00b2 \u03b8\n\n=180 +\u221a5 cos \u03b8 -180 cos\u00b2 \u03b8\n\nAdding first and second terms:\n\n180 -\u221a5 cos \u03b8 -180 cos\u00b2 \u03b8 +180 +\u221a5 cos \u03b8 -180 cos\u00b2 \u03b8\n\n=360 -360 cos\u00b2 \u03b8\n\nTherefore, N_x - M_x = (360 -360 cos\u00b2 \u03b8 ) / (81 -80 cos\u00b2 \u03b8 )\n\nFactor numerator:\n\n360(1 -cos\u00b2 \u03b8 ) =360 sin\u00b2 \u03b8\n\nTherefore, N_x - M_x =360 sin\u00b2 \u03b8 / (81 -80 cos\u00b2 \u03b8 )\n\nThus, the slope (N_y - M_y )/(N_x - M_x ) is:\n\n[ - sin \u03b8 * (8\u221a5 cos \u03b8 ) / (81 -80 cos\u00b2 \u03b8 ) ] / [ 360 sin\u00b2 \u03b8 / (81 -80 cos\u00b2 \u03b8 ) ]\n\n= [ -8\u221a5 cos \u03b8 sin \u03b8 / (81 -80 cos\u00b2 \u03b8 ) ] * [ (81
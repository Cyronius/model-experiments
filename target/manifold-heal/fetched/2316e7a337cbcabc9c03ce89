g the current round and all possible future states, weighted by their probabilities.\n\n### Solution Code\n```python\nimport math\nfrom functools import lru_cache\n\ndef main():\n    import sys\n    input = sys.stdin.read().split()\n    idx = 0\n    N = int(input[idx]); idx +=1\n    D = int(input[idx]); idx +=1\n    C = int(input[idx]); idx +=1\n    \n    cesar = list(map(int, input[idx:idx+C]))\n    idx += C\n    raul = list(map(int, input[idx:idx+C]))\n    idx += C\n    \n    set_cesar = set(cesar)\n    set_raul = set(raul)\n    common = set_cesar.intersection(set_raul)\n    u0 = len(set_cesar - common)\n    v0 = len(set_raul - common)\n    w0 = len(common)\n    \n    @lru_cache(maxsize=None)\n    def expected(u, v, w):\n        if (u + w) == 0 or (v + w) == 0:\n            return 0.0\n        total = 0.0\n        prob_self = 0.0\n        rest = N - (u + v + w)\n        for x in range(0, min(u, D) + 1):\n            for y in range(0, min(v, D - x) + 1):\n                remaining_after_xy = D - x - y\n                if remaining_after_xy < 0:\n                    continue\n                for z in range(0, min(w, remaining_after_xy) + 1):\n                    d = remaining_after_xy - z\n                    if d < 0 or d > rest:\n                        continue\n                    # Calculate combinations\n                    c_u = math.comb(u, x) if x <= u else 0\n                    c_v = math.comb(v, y) if y <= v else 0\n                    c_w = math.comb(w, z) if z <= w else 0\n                    c_rest = math.comb(rest, d) if d <= rest else 0\n                    numerator = c_u * c_v * c_w * c_rest\n                    denominator = math.comb(N, D)\n                    if denominator == 0:\n                        continue\n                    prob = numerator / denominator\n                    new_u = u - x\n                    new_v = v - y\n                    new_w = w - z\n                    # Check if new state is same as current\n                
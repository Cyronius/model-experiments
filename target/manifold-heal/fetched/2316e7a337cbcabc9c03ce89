ections import defaultdict, Counter\n\ndef solve():\n    input = sys.stdin.read().split()\n    T = int(input[0])\n    cases = input[1:T+1]\n    for s in cases:\n        n = len(s)\n        count = Counter(s)\n        odd_counts = sum(1 for c in count.values() if c % 2 != 0)\n        possible = True\n        if n % 2 == 0:\n            if odd_counts != 0:\n                possible = False\n        else:\n            if odd_counts != 1:\n                possible = False\n        if not possible:\n            print(-1)\n            continue\n        char_indices = defaultdict(list)\n        for idx, c in enumerate(s):\n            char_indices[c].append(idx + 1)  # Using 1-based indices\n        perm = [0] * n\n        left = 0\n        right = n - 1\n        middle_pos = n // 2 if n % 2 else None\n        # Process each character's indices\n        for c in char_indices:\n            indices = char_indices[c]\n            cnt = len(indices)\n            if cnt % 2 == 1:\n                # Assign middle value\n                mid_val = indices[-1]\n                perm[middle_pos] = mid_val\n                # Process remaining pairs\n                for i in range(0, len(indices) - 1, 2):\n                    a = indices[i]\n                    b = indices[i + 1]\n                    perm[left] = a\n                    perm[right] = b\n                    left += 1\n                    right -= 1\n            else:\n                # Process all pairs\n                for i in range(0, len(indices), 2):\n                    a = indices[i]\n                    b = indices[i + 1]\n                    perm[left] = a\n                    perm[right] = b\n                    left += 1\n                    right -= 1\n        print(' '.join(map(str, perm)))\n\nsolve()\n```\n\n### Explanation\n1. **Reading Input**: The input is read in one go for efficiency, especially for large inputs.\n2. **Palindrome Check**: Using a counter, we check if the string can be rearranged into a
 + 1} + \\sqrt{x_2^2 + 1}} \\leq 1.\n     \\]\n   - Therefore, \n     \\[\n     \\frac{x_1 + x_2}{\\sqrt{x_1^2 + 1} + \\sqrt{x_2^2 + 1}} - a < 0 \\quad \\text{for} \\quad a \\ge 1. \n     \\]\n   - Since \\(x_1 - x_2 < 0\\), thus \n     \\[\n     (x_1 - x_2) \\left( \\frac{x_1 + x_2}{\\sqrt{x_1^2 + 1} + \\sqrt{x_2^2 + 1}} - a \\right) > 0. \n     \\]\n     Therefore, \\(f(x_1) > f(x_2)\\), proving that \\(f(x)\\) is a decreasing function.\n\n5. **Case 2: \\(0 < a < 1\\)**:\n   - There might exist two points \\(x_1 = 0\\) and \\(x_2 = \\frac{2a}{1 - a^2}\\):\n     \\[\n     f(x_1) = \\sqrt{0^2 + 1} - a \\cdot 0 = 1, \n     \\]\n     \\[\n     f \\left( \\frac{2a}{1 - a^2} \\right) = \\sqrt{ \\left( \\frac{2a}{1 - a^2} \\right)^2 + 1 } - a \\cdot \\left( \\frac{2a}{1 - a^2} \\right).\n     \\]\n   - Let's verify \\( f \\left( \\frac{2a}{1 - a^2} \\right) = 1 \\):\n     \\[\n     \\begin{aligned}\n     f \\left( \\frac{2a}{1 - a^2} \\right) &= \\sqrt{ \\frac{4a^2}{(1 - a^2)^2} + 1 } - \\left( \\frac{2a^2}{1 - a^2} \\right) \\\\\n     &= \\sqrt{ \\frac{4a^2 + (1 - a^2)^2}{(1 - a^2)^2} } - \\left( \\frac{2a^2}{1 - a^2} \\right) \\\\\n     &= \\sqrt{ \\frac{4a^2 + 1 - 2a^2 + a^4}{(1 - a^2)^2} } - \\left( \\frac{2a^2}{1 - a^2} \\right) \\\\\n     &= \\sqrt{ \\frac{2a^2 + 1 + a^4}{(1 - a^2)^2} } - \\left( \\frac{2a^2}{1 - a^2} \\right) \\\\\n     &= \\frac{ \\sqrt{2a^2 + 1 + a^4} }{1 - a^2} - \\frac{2a^2}{1 - a^2} \\\\\n     &= \\frac{ \\sqrt{ (1 - a^2)^2 + a^2}}{1 - a^2} - \\frac{2a^2}{1 - a^2} \\\\\n     &= 1. \\\\\n     \\end{aligned}\n     \\]\n   - Therefore, \\(f(x)\\) is non-monotonic, as \\(f(x_1) = f(x_2)\\).\n\n### Conclusion:\nHence, the function \\(f(x)\\) is monotonic on the interval \\([0, +\\infty)\\) if and only if \\(a \\geq 1\\).\n\n\\[\n\\boxed{a \\geq 1}\n\\]", "domain": "math", "source": "numina_math", "test_cases": null, "starter_code": null}, {"problem": "Given the quadratic polynomials \\( f_{1}(x) = x^{2} - a x - 3 \\), \\( f_{2}(x) = x^{2} + 2 x - 